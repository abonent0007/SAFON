# ============================================
# С.А.Ф.О.Н. - Конфигурация окружения
# ============================================

# ---------- НЕЙРОСЕТЬ DeepSeek V4 Pro ----------
# Режим работы:
#   lm-studio  - локальный через LM Studio (бесплатно)
#   api        - облачный DeepSeek API (платный)
DEEPSEEK_MODE=lm-studio

# Для режима api — получить ключ на platform.deepseek.com
DEEPSEEK_API_KEY=sk-your-deepseek-api-key-here
DEEPSEEK_API_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat

# Для режима lm-studio (локальный, без ключей)
LM_STUDIO_URL=http://localhost:1234/v1
LM_STUDIO_MODEL=deepseek-v4-pro

# ---------- Карта (бесплатный OpenStreetMap / Leaflet, ключ не нужен) ----------

# ---------- Email (опционально, нужен App Password Gmail) ----------
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your_email@gmail.com
SMTP_PASSWORD=your_16_digit_app_password
NOTIFICATION_EMAIL=recipient@gmail.com

# ---------- Настройки прогнозирования ----------
HIGH_IMPORTANCE_THRESHOLD=0.70
PREDICTION_HORIZON=80
